{
  "name": "wmux-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @wmux/desktop tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "pnpm --filter @wmux/desktop tauri build",
    "test": "pnpm --filter @wmux/desktop test && cargo test --workspace",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:restore": "node tests/e2e/restore.mjs",
    "test:e2e:dnd": "node tests/e2e/dnd.mjs",
    "test:e2e:agents": "node tests/e2e/agents.mjs",
    "site:screenshots": "node scripts/site-screenshots.mjs",
    "typecheck": "pnpm --filter @wmux/desktop typecheck"
  },
  "devDependencies": {
    "playwright-core": "^1.49.0"
  }
}
